<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QR Code Generator</title>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrious/4.0.2/qrious.min.js"></script>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f7fb;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .container {
            background: white;
            width: 100%;
            max-width: 500px;
            padding: 35px 25px;
            border-radius: 16px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
            text-align: center;
        }

        h1 {
            color: #222;
            margin-bottom: 10px;
            font-size: 30px;
        }

        .description {
            color: #666;
            margin-bottom: 25px;
            font-size: 15px;
        }

        input {
            width: 100%;
            padding: 14px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 16px;
            outline: none;
            margin-bottom: 15px;
        }

        input:focus {
            border-color: #333;
        }

        button {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 8px;
            background: #222;
            color: white;
            font-size: 16px;
            cursor: pointer;
            margin-top: 5px;
        }

        button:hover {
            background: #444;
        }

        #qrcode {
            margin-top: 25px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        #qrcode canvas {
            max-width: 100%;
            height: auto;
            border: 8px solid white;
        }

        #downloadBtn {
            display: none;
            margin-top: 20px;
            background: #198754;
        }

        #downloadBtn:hover {
            background: #146c43;
        }

        .error {
            color: #d32f2f;
            margin-top: 15px;
            font-size: 14px;
            display: none;
        }

        @media (max-width: 480px) {
            .container {
                padding: 25px 18px;
            }

            h1 {
                font-size: 25px;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>QR Code Generator</h1>

        <p class="description">
            Enter any text or URL to generate your QR code.
        </p>

        <input
            type="text"
            id="qrText"
            placeholder="Enter text or URL"
            autocomplete="off"
        >

        <button onclick="generateQR()">
            Generate QR Code
        </button>

        <p class="error" id="errorMessage">
            Please enter some text or a URL.
        </p>

        <div id="qrcode"></div>

        <button id="downloadBtn" onclick="downloadQR()">
            Download QR Code
        </button>

    </div>

    <script>
        let qr;

        function generateQR() {
            const text = document.getElementById("qrText").value.trim();
            const qrContainer = document.getElementById("qrcode");
            const errorMessage = document.getElementById("errorMessage");
            const downloadButton = document.getElementById("downloadBtn");

            if (!text) {
                qrContainer.innerHTML = "";
                errorMessage.style.display = "block";
                downloadButton.style.display = "none";
                return;
            }

            errorMessage.style.display = "none";
            qrContainer.innerHTML = "";

            qr = new QRious({
                value: text,
                size: 250,
                level: "H",
                background: "white",
                foreground: "black"
            });

            qrContainer.appendChild(qr.canvas);

            downloadButton.style.display = "block";
        }

        function downloadQR() {
            if (!qr) {
                return;
            }

            const link = document.createElement("a");

            link.download = "qr-code.png";
            link.href = qr.toDataURL("image/png");

            link.click();
        }

        document.getElementById("qrText").addEventListener("keypress", function(event) {
            if (event.key === "Enter") {
                generateQR();
            }
        });
    </script>

</body>
</html>
